<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial, sans-serif}
body{background:#000;color:white}
header{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;background:#000}
header h1{font-size:32px;font-weight:900;letter-spacing:1px}
header h1 span{color:#FFCC00}
.menu{font-size:28px}
.hero{text-align:center;padding:30px 15px 10px;background:radial-gradient(circle at top, #2a2200 0%, #000 60%)}
.pill{display:inline-block;border:1px solid #FFCC00;color:#FFCC00;padding:8px 18px;border-radius:25px;font-size:12px;letter-spacing:2px}
.hero h2{font-size:48px;font-weight:900;line-height:1.05;margin:20px 0 10px}
.hero h2 span{color:#FFCC00}
.hero p{color:#bbb;font-size:15px;line-height:1.5;padding:0 10px}
.hero p b{color:#FFCC00}
.yellow-card{background:#FFCC00;color:#000;border-radius:25px;padding:22px;margin:20px 15px}
.yellow-card h3{font-size:26px;font-weight:900;margin-bottom:12px}
.yellow-card p{font-size:15px;margin:8px 0;font-weight:600}
.dark-card{background:#111;border:1px solid #222;border-radius:25px;padding:22px;margin:15px;text-align:center}
.dark-card h3{font-size:24px;font-weight:900;margin-bottom:15px}
.btn-yellow{background:#FFCC00;color:#000;border:none;padding:13px 30px;border-radius:30px;font-weight:900;font-size:16px;margin:6px}
.btn-outline{background:transparent;color:#FFCC00;border:1px solid #FFCC00;padding:13px 30px;border-radius:30px;font-weight:900;font-size:16px;margin:6px;width:80%}
.section{padding:10px 0}
.director-card{background:#1a1a1a;border-radius:25px;padding:20px;margin:15px;display:flex;gap:15px;align-items:center}
.director-card img{width:70px;height:70px;border-radius:50%;object-fit:cover;border:3px solid #FFCC00;background:#333}
.director-card b{font-size:18px}
.director-card span{color:#FFCC00;font-size:13px}
.gallery{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 15px}
.gallery img{width:100%;height:150px;object-fit:cover;border-radius:18px;background:#222}
input,select,textarea{width:100%;padding:13px;margin:7px 0;border-radius:12px;border:none;background:#222;color:white}
footer{text-align:center;padding:25px;color:#888;font-size:13px}
